SECRET_KEY=secret-key
SESSION_SECRET=session-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false

# OAuth callback must match the URI registered in Google Cloud Console exactly.

GOOGLE_CLIENT_ID_1=your-google-client-id
GOOGLE_CLIENT_SECRET_1=your-google-client-secret
OPENAI_API_KEY=your-openai-api-key

GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
FRONTEND_URL=http://localhost:5173

# Composio / Agents
COMPOSIO_API_KEY=composio-api-key
MODEL="gpt-5-nano"
OPENAI_API_KEY=your-openai-api-key

# For sensitive actions, enforce authorization/approval policies in Composio too.
MCP_REQUIRE_APPROVAL=never

# Local SQLite by default. For PostgreSQL use postgresql+asyncpg://user:password@localhost:5432/authspace
DATABASE_URL=sqlite+aiosqlite:///./authspace.db
# Comma-separated exact frontend origins; add the other computer's frontend origin if needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUESTION_LENGTH=8000
